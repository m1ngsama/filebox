# Example systemd unit. Copy it to /etc/systemd/system/filebox.service and change the user, paths and -origin.
#   sudo useradd --system --home /srv/filebox --shell /usr/sbin/nologin filebox
#   sudo install -d -o filebox -g filebox /srv/filebox
[Unit]
Description=filebox
After=network-online.target
Wants=network-online.target

[Service]
User=filebox
Group=filebox
ExecStart=/usr/local/bin/filebox serve -data /srv/filebox/data -listen 127.0.0.1:5280 -ffmpeg /usr/bin/ffmpeg -origin https://files.example.com \
  -vol files=/srv/filebox/files
Restart=always
RestartSec=2
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/filebox
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Office previews run LibreOffice in its own user and network namespace.
RestrictNamespaces=user net
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
