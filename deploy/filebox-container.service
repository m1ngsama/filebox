# greenArch: starts the filebox container once its folders are mounted, like the old filebox.service did.
# Install as /etc/systemd/system/filebox-container.service, `systemctl enable --now filebox-container`.
[Unit]
Description=filebox (container)
Requires=docker.service filebox-media-mounts.service
After=docker.service filebox-media-mounts.service network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/backup1t/downloads /mnt/backup1t/archive /mnt/backup1t/library
BindsTo=mnt-backup1t.mount
After=mnt-backup1t.mount

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/apps/filebox
ExecStart=/usr/bin/docker compose up -d --wait --wait-timeout 120
ExecStop=/usr/bin/docker compose stop

[Install]
WantedBy=multi-user.target
