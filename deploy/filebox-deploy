#!/bin/bash
# Moves filebox on this server to a released image. Run as root through sudo, by the deploy key's forced command:
#   authorized_keys:  restrict,command="sudo /usr/local/sbin/filebox-deploy" ssh-ed25519 AAAA... filebox-deploy
# Standard input is one line: a version such as v0.1.0, or `rollback`. Nothing else is accepted, so the key can run the
# image this repository published for a version, and go back one step, and do nothing more.
set -euo pipefail

dir=/srv/apps/filebox
answer=http://127.0.0.1:5280/

read -r -t 10 want || exit 2
cd "$dir"
# A dropped connection or a cancelled job must not stop a deploy halfway.
trap '' HUP

healthy() {
  for _ in $(seq 1 30); do
    curl -fsS -o /dev/null --max-time 3 "$answer" && return 0
    sleep 1
  done
  return 1
}

run() {
  docker compose up -d --remove-orphans --wait --wait-timeout 120 filebox && healthy
}

back() {
  [ -s .env.prev ] || { echo "no previous version to go back to" >&2; exit 1; }
  cp -f .env.prev .env
  if docker compose up -d --remove-orphans --wait --wait-timeout 120 filebox && healthy; then
    echo "went back to $(cat .env)"
  else
    echo "the previous version does not answer either" >&2
    exit 1
  fi
}

if [ "$want" = rollback ]; then
  back
  exit 0
fi

[[ "$want" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "not a version: $want" >&2; exit 2; }

# Fetch the new image first, with the version given by the environment (which wins over .env), so that a slow or failed pull
# leaves .env and the running container exactly as they were.
FILEBOX_TAG="$want" docker compose pull filebox
[ -f .env ] && cp -f .env .env.prev
echo "FILEBOX_TAG=${want}" > .env
if run; then
  echo "now running ${want}"
else
  echo "${want} does not answer, going back" >&2
  back
  exit 1
fi
